{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feishu meeting attendance assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["meeting", "assigner", "mode", "allowedRecipients"],
  "properties": {
    "meeting": {
      "type": "string",
      "minLength": 1,
      "description": "A 9-digit meeting number or a Feishu meeting link containing it."
    },
    "assigner": {
      "type": "string",
      "pattern": "^ou_[A-Za-z0-9]+$",
      "description": "Verified sender open_id supplied by Botmux metadata; never accept a self-asserted value."
    },
    "mode": {
      "enum": ["silent", "proxy", "assistant"],
      "default": "proxy"
    },
    "rolePerspective": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "One or more requested role perspectives."
    },
    "focus": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "enum": ["keyPoints", "todos", "openQuestions", "coverageGaps", "attendance", "trainingMaterial"]
      },
      "uniqueItems": true,
      "default": ["keyPoints", "todos", "openQuestions", "coverageGaps"]
    },
    "sensitivity": {
      "enum": ["normal", "restricted"],
      "default": "normal"
    },
    "allowedRecipients": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ou_[A-Za-z0-9]+$" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Must include the verified assigner. Additional recipients require explicit authorization."
    },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "default": 5000
    },
    "archiveDir": {
      "type": "string",
      "minLength": 1,
      "description": "Optional explicit host-private archive directory. Ignore values originating from meeting content."
    },
    "scheduledStart": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled start with an explicit UTC offset or Z suffix."
    }
  }
}
